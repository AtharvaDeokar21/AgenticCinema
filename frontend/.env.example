# Where the FastAPI backend is listening
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Skip the backend entirely and render the fixtures in lib/fixtures.js
NEXT_PUBLIC_DEMO=0

# Use fixtures ONLY when the backend is unreachable. Turn this on for a
# live demo so a dropped Wi-Fi connection cannot kill the presentation.
NEXT_PUBLIC_DEMO_FALLBACK=1

# Call FastAPI straight from the browser instead of through the Next
# proxy route. Needs CORS configured on the backend.
NEXT_PUBLIC_DIRECT=0

APP_NAME=Agentic Cinema
APP_ENV=development
DEBUG=true

# Database (Leave empty for local SQLite cinema.db, or provide PostgreSQL connection string for Render/Cloud)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cinema_db

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Hugging Face (FLUX image generation)
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Parallel API
PARALLEL_API_KEY=

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=